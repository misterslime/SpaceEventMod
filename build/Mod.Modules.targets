<Project>

    <!-- Modules and Libraries -->
    <ItemGroup>
        <Libraries Include="..\TileHelper\TileHelper.csproj" />

        <ProjectReference Include="@(Libraries)" />
        
        <ProjectReference Include="..\daybreak-mod\src\Daybreak\Daybreak.csproj" />
        <ProjectReference Include="..\daybreak-mod\src\Daybreak.CodeAnalysis\Daybreak.CodeAnalysis.csproj" PrivateAssets="All" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    </ItemGroup>

    <Target Name="PackageModules" BeforeTargets="Build">
        <Message Text="$(MSBuildThisFileDirectory)" Importance="high" />

        <MSBuild Projects="@(Libraries)" Targets="Build" Properties="Configuration=Release">
            <Output TaskParameter="TargetOutputs" ItemName="BuildOutput" />
        </MSBuild>

        <Copy SourceFiles="@(BuildOutput)" DestinationFolder="$(ProjectDir)lib\" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(BuildOutput->'%(Identity)'->Replace('.dll', '.pdb'))" DestinationFolder="$(ProjectDir)lib\" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    </Target>

</Project>